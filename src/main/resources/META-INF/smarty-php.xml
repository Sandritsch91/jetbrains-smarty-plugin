<!-- Loaded only when the PHP plugin is installed: template variables passed in from PHP code. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.smartyplugin">
        <variableProvider implementation="com.smartyplugin.php.SmartyPhpVariableProvider"/>
        <pluginProvider implementation="com.smartyplugin.php.SmartyPhpRegisteredPlugins"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <completion.contributor language="SmartyTpl" order="first"
                                implementationClass="com.smartyplugin.php.SmartyPhpCompletionContributor"/>
        <gotoDeclarationHandler implementation="com.smartyplugin.php.SmartyPhpGotoDeclarationHandler"/>
        <gotoDeclarationHandler implementation="com.smartyplugin.php.SmartyPhpViewGotoDeclarationHandler"/>
        <documentationProvider implementation="com.smartyplugin.php.SmartyPhpDocumentationProvider" order="first"/>
    </extensions>
</idea-plugin>
