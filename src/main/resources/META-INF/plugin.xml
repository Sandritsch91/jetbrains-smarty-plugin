<idea-plugin>
    <id>io.github.sandritsch91.smarty</id>
    <name>Smarty Templates</name>
    <vendor url="https://github.com/Sandritsch91/jetbrains-smarty-plugin">Sandritsch91</vendor>

    <description><![CDATA[
    Support for <a href="https://www.smarty.net/">Smarty</a> 3/4/5 templates (<code>.tpl</code>, <code>.smarty</code>)
    in IntelliJ IDEA, PhpStorm and other IDEs with HTML support.
    <h3>Editing</h3>
    <ul>
      <li>Highlighting of Smarty tags, also inside double-quoted strings, on top of full HTML/CSS/JavaScript</li>
      <li>Completion of tags, closing tags, attributes, modifiers, variables, <code>$smarty</code> properties and <code>{#config#}</code> variables</li>
      <li>Formatting: Smarty blocks indented with the HTML, spacing inside tags; <code>{registerJs}</code> / <code>{registerCss}</code> code formatted as JavaScript / CSS</li>
      <li>Errors for unclosed blocks and misplaced <code>{else}</code> tags, with quick fixes</li>
      <li>Live templates, folding, brace and tag-pair matching, auto-closing of block tags, <code>{* TODO *}</code> in the TODO window</li>
      <li>Rename of template variables, also where PHP passes them in</li>
      <li>Custom delimiters (<code>{{ }}</code>, <code>&lt;!--{ }--&gt;</code>) per project</li>
    </ul>
    <h3>Navigation</h3>
    <ul>
      <li>Ctrl+Click on <code>{include}</code> / <code>{extends}</code> / <code>{config_load}</code> paths, template variables and config variables</li>
      <li>Template inheritance: block name completion, navigation and gutter icons between overriding blocks</li>
      <li>The project's Smarty plugins (<code>function.x.php</code>, <code>registerPlugin()</code>): completion and navigation</li>
    </ul>
    <h3>PHP and Yii2 (with the PHP plugin, bundled in PhpStorm)</h3>
    <ul>
      <li>Variables passed in by <code>render()</code>, <code>assign()</code> or <code>{include}</code>, with their PHP types and member completion along chains</li>
      <li>Ctrl+Click and hover documentation for classes, members, widget tags and their attributes; from <code>render('view')</code> to the template</li>
      <li>Yii2 widgets as tags and in <code>::widget([...])</code> configuration, <code>$app</code> / <code>$this</code>, all yii2-smarty functions and blocks</li>
      <li>Yii routes in <code>{url}</code> / <code>Url::to()</code> and translations in <code>|t</code> / <code>Yii::t()</code> from <code>.po</code> and PHP message files</li>
    </ul>
    ]]></description>


    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends optional="true" config-file="smarty-php.xml">com.jetbrains.php</depends>

    <extensionPoints>
        <extensionPoint qualifiedName="com.smartyplugin.variableProvider"
                        interface="com.smartyplugin.lang.SmartyVariableProvider" dynamic="true"/>
        <extensionPoint qualifiedName="com.smartyplugin.pluginProvider"
                        interface="com.smartyplugin.lang.SmartyPluginProvider" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.smartyplugin">
        <variableProvider implementation="com.smartyplugin.psi.SmartyIncludeVariableProvider"/>
        <pluginProvider implementation="com.smartyplugin.lang.SmartyPluginFileProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <gotoDeclarationHandler implementation="com.smartyplugin.editor.SmartyGotoDeclarationHandler"/>
        <renameHandler implementation="com.smartyplugin.editor.SmartyVariableRenameHandler"/>
        <liveTemplateContext contextId="SMARTY" implementation="com.smartyplugin.editor.SmartyTemplateContextType"/>
        <defaultLiveTemplates file="/liveTemplates/Smarty.xml"/>
        <indexPatternBuilder implementation="com.smartyplugin.editor.SmartyIndexPatternBuilder"/>
        <localInspection language="SmartyTpl" shortName="SmartyUnknownName" displayName="Unknown tag or modifier"
                         groupName="Smarty" enabledByDefault="false" level="WARNING"
                         implementationClass="com.smartyplugin.editor.SmartyUnknownNameInspection"/>
        <highlightUsagesHandlerFactory implementation="com.smartyplugin.editor.SmartyVariableHighlightUsagesFactory"/>
        <documentationProvider implementation="com.smartyplugin.editor.SmartyDocumentationProvider"/>
        <multiHostInjector implementation="com.smartyplugin.editor.SmartyCodeBlockInjector"/>
        <projectConfigurable parentId="language" id="smarty" displayName="Smarty"
                             instance="com.smartyplugin.lang.SmartyConfigurable"/>
        <fileType name="Smarty template"
                  implementationClass="com.smartyplugin.lang.SmartyFileType"
                  fieldName="INSTANCE"
                  language="SmartyTpl"
                  extensions="tpl;smarty"/>
        <lang.parserDefinition language="SmartyTpl"
                               implementationClass="com.smartyplugin.parser.SmartyParserDefinition"/>
        <lang.fileViewProviderFactory language="SmartyTpl"
                                      implementationClass="com.smartyplugin.lang.SmartyFileViewProviderFactory"/>

        <lang.syntaxHighlighterFactory language="SmartyTpl"
                                       implementationClass="com.smartyplugin.highlighting.SmartySyntaxHighlighterFactory"/>
        <editorHighlighterProvider filetype="Smarty template"
                                   implementationClass="com.smartyplugin.highlighting.SmartyTemplateHighlighter$Provider"/>
        <colorSettingsPage implementation="com.smartyplugin.highlighting.SmartyColorSettingsPage"/>

        <annotator language="SmartyTpl" implementationClass="com.smartyplugin.editor.SmartyAnnotator"/>
        <codeInsight.lineMarkerProvider language="SmartyTpl"
                                        implementationClass="com.smartyplugin.editor.SmartyBlockLineMarkerProvider"/>
        <lang.foldingBuilder language="SmartyTpl" implementationClass="com.smartyplugin.editor.SmartyFoldingBuilder"/>
        <lang.commenter language="SmartyTpl" implementationClass="com.smartyplugin.editor.SmartyCommenter"/>
        <lang.braceMatcher language="SmartyTpl" implementationClass="com.smartyplugin.editor.SmartyBraceMatcher"/>
        <quoteHandler fileType="Smarty template" className="com.smartyplugin.editor.SmartyQuoteHandler"/>
        <typedHandler implementation="com.smartyplugin.editor.SmartyTypedHandler"/>
        <enterHandlerDelegate implementation="com.smartyplugin.editor.SmartyEnterHandler"/>
        <highlightUsagesHandlerFactory implementation="com.smartyplugin.editor.SmartyTagPairHighlighterFactory"/>

        <completion.contributor language="SmartyTpl"
                                implementationClass="com.smartyplugin.completion.SmartyCompletionContributor"/>

        <lang.formatter language="SmartyTpl" implementationClass="com.smartyplugin.formatter.SmartyFormattingModelBuilder"/>

        <lang.elementManipulator forClass="com.smartyplugin.psi.SmartyStringLiteral"
                                 implementationClass="com.smartyplugin.psi.SmartyStringManipulator"/>

        <internalFileTemplate name="Smarty File"/>
    </extensions>

    <actions>
        <action id="Smarty.NewFile" class="com.smartyplugin.actions.CreateSmartyFileAction"
                text="Smarty Template" description="Create a new Smarty template" icon="/icons/smarty.svg">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewHtmlFile"/>
        </action>
    </actions>
</idea-plugin>
